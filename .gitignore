# ============================================================
#  QQ 机器人仓库忽略清单
#  未提交内容：机器凭据 / 本机路径 / 运行时缓存 / 日志 /
#              内网穿透凭据 / 运行时下载的工具
#  注意：模式行后不要写行内注释，否则整行不会生效
# ============================================================

# 敏感 / 机器配置（绝不提交）
settings.json
启动bot.bat

# 运行时状态与缓存
state.json
tmp/
cache/
__pycache__/
*.pyc
*.pyo
*.tmp

# 运行时用户数据（钱包/钓鱼/签到/食物等，不入库）
data/
bot/data/

# 日志
*.log
*.log.err
botpy.log
botpy.log.*
_run.log
logs/

# 运行状态（PID 文件，本机运行痕迹）
.bot.pid
.watchdog.pid

# 内网穿透 / 隧道（含本机 cloudflared 凭据）
cloudflared.exe
tunnel/

# 运行时下载的工具（由 install.ps1 首次自动拉取）
tools/

# 项目级共享 venv：给 cardforge 等需要独立依赖的工具复用，位置固定 tools/.venv。
# 由 install 脚本创建（见 bot/core/venv.py），体积大且可重建，不入库。
# 上面 tools/ 已覆盖，这里显式写出以表明「这是运行时目录，不是项目资产」。
tools/.venv/

# 运行时从 GitHub 资源仓库克隆的素材（图库/龙图，由 install.ps1 拉取，不入库）
resources/

# ⚠️ 注意：bot/assets/fonts/ 是【必须入库】的项目资产（内置字体包），
#    用于让 meme 等渲染在没装中文字体的机器上也正常出字，别加忽略规则。
#    重新生成：python bot/meme/build_font_bundle.py
#    内含：
#      qqbot-fonts.ttc     中文字体集合（21 个族名别名，约 3.6MB）
#      NotoColorEmoji.ttf  彩色 emoji（Noto Color Emoji，OFL-1.1，约 10MB）

# 运行时从 meme 源仓库拉取的批量模板（不入库；feiyu 为本地移植插件需保留）
bot/meme/custom_memes/*
!bot/meme/custom_memes/feiyu/
!bot/meme/custom_memes/feiyu/**

# feiyu 目录内的缓存不提交
bot/meme/custom_memes/feiyu/__pycache__/

# meme 关键字数据的备份文件
*.bak_*

# 开发期自动生成的代码快照备份（改版前的临时留档，不属于项目资产）
backups/

# 部署打包产物
dist/

# 本地备忘 / 给 AI 看的工作文档（属本机开发资料，非项目资产）
DIY卡牌计划.md
卡牌制作测试清单.md
管理后台测试清单.md

# 其他
.DS_Store
Thumbs.db
desktop.ini

# Linux 部署：venv 与根目录运行时二进制（不入库）
.venv/
venv/
/cloudflared